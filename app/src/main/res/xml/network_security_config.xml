<network-security-config>
    <base-config>
        <!--
        Explicitly enable certificate transparency so that it's enabled on Android 16, which supports
        the feature but doesn't enable it by default
        -->
        <certificateTransparency enabled="true" />
    </base-config>
</network-security-config>
